# Last.fm API application credentials. This project-local .env is the
# default location; missing values may also be read from ~/.env.
API_KEY=
API_SECRET=

# Option A: obtain a mobile session when needed
LASTFM_USERNAME=
LASTFM_PASSWORD=

# Option B: use an existing Last.fm session key instead of a password
LASTFM_SESSION_KEY=

# Named account/profile and credential source:
# auto | file | environment | keychain
LASTFM_PROFILE=default
LASTFM_CREDENTIAL_SOURCE=auto

# Scrobble defaults
SCROBBLE_INTERVAL=2s
SCROBBLE_LIMIT=0
SCROBBLE_LOOP=1

# Reliability and safety
SCROBBLE_RETRIES=2
SCROBBLE_RETRY_DELAY=2s
SCROBBLE_DUPLICATE_GUARD=0

# Interface and output
SCROBBLE_NOTIFY=true
SCROBBLE_COMPACT_HEADER=false
SCROBBLE_CLEAN_DISCOGRAPHY=false
SCROBBLE_EXPORT_DIR=~/Downloads

# Optional: force a separate credentials/settings file
# LASTFM_ENV_FILE=~/.config/lastfm-scrobbler/credentials.env

# Mouse and update checking
SCROBBLE_MOUSE=true
# Set this to a GitHub releases/latest API URL or a custom JSON endpoint.
# SCROBBLER_UPDATE_URL=https://api.github.com/repos/OWNER/REPOSITORY/releases/latest
